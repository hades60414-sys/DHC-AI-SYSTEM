# 只有本機單客戶原型；不放真金鑰，不啟用 Cloudflare。
DHC_HTTP_PORT=3001
DHC_IMAGE=dhc-enterprise:local
# 安裝時以 git rev-parse HEAD 設定；未提交變更另記 evidence patch 指紋。
DHC_SOURCE_SHA=unrecorded
# 每個客戶使用不同 project 名稱及 volume，不能共用此範例名稱。
COMPOSE_PROJECT_NAME=dhc-local
# 先執行產生本機資料庫密碼.py；此路徑只指向本機0600 env_file，沒有真密碼。
DHC_SECRET_DIR=./.secrets
DHC_DATABASE_NAME=dhc_enterprise
