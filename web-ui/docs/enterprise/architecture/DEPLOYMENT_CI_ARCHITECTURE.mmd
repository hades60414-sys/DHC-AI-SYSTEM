  pr["Pull Request（main 或 integration/enterprise-rcfix-v4-20261106）<br/>permissions: contents read、無 secrets<br/>[CURRENT＋stacked PR 觸發 NEW_IN_V5]"]:::newv5
  subgraph verify["enterprise-verify（ubuntu-24.04）"]
    su["static-and-unit：比對器單元測試→typecheck→oxlint JSON→後端 TAP→前端 vitest→基線比對（fail closed）<br/>[CURRENT／比對器 v2 NEW_IN_V5]"]:::newv5
    pg["postgres-integration：PostgreSQL 16 固定 digest、全部 *.integration.test.ts 序列執行<br/>[CURRENT]"]:::current
    probe["資源邊界探針、UAT 證據索引檢查、CSV 實測素材<br/>[NEW_IN_V51]"]:::newv51
    lo["csv-spreadsheet-safety：LibreOffice Calc 無頭匯入（求值公式開）<br/>[NEW_IN_V51]"]:::newv51
  end
  subgraph image["enterprise-image-build"]
    a64["build-amd64（ubuntu-24.04 原生）"]:::current
    r64["build-arm64（ubuntu-24.04-arm 原生）"]:::current
    scan["SBOM＋Trivy（digest 釘選）＋image summary<br/>[CURRENT]"]:::current
    dl["enterprise-delivery-smoke（reusable，各架構載入實際 image）<br/>install／migration／health／E2E<br/>[CURRENT]；報表／匯出端到端耗時 [NEW_IN_V51]"]:::current
    upg["upgrade-rollback-amd64：V4（1e481e2）image → 本次 image 升級＋還原回退<br/>[NEW_IN_V51]"]:::newv51
