%% OPS-REPORT-v1 營運週報資料流（NEW_IN_V5）。
flowchart LR
  classDef current fill:#e8f1e8,stroke:#3d6b3d,color:#2A2A2A
  classDef newv5 fill:#e6eef8,stroke:#2f5d8a,color:#2A2A2A
  classDef newv51 fill:#e9e6f6,stroke:#5a4a9a,color:#2A2A2A
  classDef planned fill:#f4f1e6,stroke:#8a7a2f,color:#2A2A2A,stroke-dasharray:4 3

  src["1–5 個營運明細文件版本<br/>＋ISO 週別＋明示案例集"]:::newv5
  key["冪等鍵 input_key<br/>＝SHA-256(排序後版本 id＋hash、案例集)"]:::newv5
  gate["計算閘門（併發 2／佇列 8，滿→429）<br/>[NEW_IN_V51]"]:::newv51
  prepare["prepare 短交易：驗證、依 byte_size 快速拒絕（>25 MiB→413）、既有結果<br/>[NEW_IN_V51]"]:::newv51
  load["交易外依序讀 blob＋重驗 hash，逐一釋放；斷線即中止<br/>[NEW_IN_V51]"]:::newv51
  commit["commit 新交易：重驗 session（停權→401）與權益後寫入<br/>[NEW_IN_V51]"]:::newv51
  engine["runOpsReportV1（純函式）<br/>BigInt、ROUND_HALF_UP 至百分之一<br/>空值 UNKNOWN、同站多列 CONFLICT<br/>守恆／準時數異常只列不改<br/>[NEW_IN_V51] 解碼前掃描單行 16 KiB、合計 5 萬列"]:::newv5
  claims["14 項主張<br/>value＋scale、分子分母、來源列<br/>[NEW_IN_V51] 每項最多 200 參照＋總數／truncated（5 萬列結果 75 MB→0.4 MB）"]:::newv5
  store[("ops_reports＋ops_report_sources<br/>completed 唯一、只新增、FORCE RLS")]:::newv5
  audit[("audit_events<br/>ops_report.completed／rejected")]:::newv5
  llm["模型撰寫敘述<br/>[PLANNED]"]:::planned
  guard["validateOpsNarrative<br/>數字必須出自引擎、百分點≠%<br/>[NEW_IN_V5]"]:::newv5
  approve["送審／簽認／正式匯出<br/>[PLANNED]"]:::planned

  src --> gate --> prepare --> key --> load --> engine --> claims --> commit --> store --> audit
  claims -.-> llm -.-> guard -.-> approve
